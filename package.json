{
  "name": "glasses-local",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Local discovery catalogue, agent MCP and isolated visual workbench",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "start": "node src/server.mjs",
    "dev": "npm run build && npm start",
    "mcp": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "catalogue:bulk": "node scripts/bulk-scan.mjs",
    "catalogue:fetch": "node scripts/catalogue-setup.mjs --catalogue=import",
    "catalogue:status": "node scripts/catalogue-setup.mjs --status",
    "catalogue:import": "node scripts/export-public-catalogue.mjs --import catalogue/catalogue.json --data-dir .glasses",
    "catalogue:validate": "node scripts/export-public-catalogue.mjs --validate catalogue/catalogue.json",
    "mcp:config": "node scripts/print-mcp-config.mjs",
    "mcp:install": "node scripts/install-codex-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@vercel/blob": "2.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.48.0",
    "motion": "13.4.4",
    "radix-ui": "1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lcfrai/glasses.git"
  },
  "homepage": "https://lcfr.ai/glasses"
}
